# ==========================================
# Nubra UAT Relay & Queue Gateway Configuration
# ==========================================

# 1. Host Nubra Master Credentials (REQUIRED)
# Obtain these from your Nubra account settings under UAT Credentials
NUBRA_UAT_BASE=https://uatapi.nubra.io
NUBRA_SESSION_TOKEN=your_master_uat_session_token_here
NUBRA_DEVICE_ID=your_master_uat_device_id_here

# 2. Workshop Student Security Controls
# Set to 'false' for simple token validation (default for workshops)
# Set to 'true' to enforce registration against students.json
ENABLE_STUDENT_VERIFICATION=false
STUDENTS_FILE_PATH=students.json
ALLOWED_STUDENT_TOKENS=STU_TOKEN_ALPHA,STU_TOKEN_BRAVO,STU_TOKEN_CHARLIE,STU_DEMO
STUDENT_TOKEN_PREFIX=STU_

# 3. Rate Limiting & Queue Governor (Matched to official Nubra limits)
# Trading & General APIs (Nubra UAT ceiling: 100 ops/sec per IP)
MAX_UPSTREAM_RPS=85

# Historical Data REST API (Nubra ceiling: 60 req/min per IP)
MAX_HISTORICAL_RPM=50

# 4. Redis Caching & State
REDIS_URL=redis://redis:6379/0
ENABLE_CACHE=true

# Cache TTLs in seconds
CACHE_TTL_INSTRUMENTS=3600
CACHE_TTL_ORDERBOOK=1.5
CACHE_TTL_QUOTES=1.0
CACHE_TTL_HISTORICAL=60.0
CACHE_TTL_DEFAULT=2.0

# 5. Zero-Trust Ingress: Tailscale Funnel
# Generate an auth key from: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
